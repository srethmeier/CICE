{
    "backups": {
        "host": "backup.example.com",
        "port": 22,
        "user": "backupuser",
        "key_path": "/keys/backup_rsa",
        "remote_dir": "/data/backups"
    },
    "logs": {
        "host": "logs.example.com",
        "user": "logwriter",
        "key_path": "/keys/log_rsa",
        "remote_dir": "/var/incoming"
    }
}
